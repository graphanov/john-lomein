{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://john-lomein.invalid/schemas/persona-qualification-capture-plan.v1.schema.json",
  "title": "John Lomein opaque qualification capture plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_slug",
    "evidence_uid",
    "verifier_gid",
    "sources",
    "limits",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": "john-lomein.persona-qualification-capture-plan.v1"
    },
    "instance_slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "evidence_uid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "verifier_gid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_class",
          "kind",
          "source_path",
          "destination_path"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "source_class": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "file",
              "tree"
            ]
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/"
          },
          "destination_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^/]+(?:/[^/]+)*$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_files",
        "max_directories",
        "max_bytes",
        "max_file_bytes",
        "max_depth"
      ],
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_directories": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention",
        "max_capture_slots",
        "max_orphan_age_seconds"
      ],
      "properties": {
        "retention": {
          "const": "ephemeral"
        },
        "max_capture_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_orphan_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
