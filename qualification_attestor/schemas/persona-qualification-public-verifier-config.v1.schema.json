{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:john-lomein:schema:persona-qualification-public-verifier-config:v1",
  "title": "John Lomein persona qualification public verifier pins",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_path",
    "instance_slug",
    "attestor_key_id",
    "public_key_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "john-lomein.persona-qualification-public-verifier-config.v1"
    },
    "projection_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "instance_slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "attestor_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+~-]{0,127}$"
    },
    "public_key_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
