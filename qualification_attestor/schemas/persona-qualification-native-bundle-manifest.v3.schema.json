{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://john-lomein.invalid/schemas/persona-qualification-native-bundle-manifest.v3.schema.json",
  "title": "John Lomein dormant native qualification bundle manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "role",
    "platform",
    "filesystem_policy",
    "ownership_classes",
    "mode_classes",
    "python_runtime",
    "wheel_provenance",
    "macho",
    "inventory",
    "activation",
    "digests"
  ],
  "properties": {
    "schema_version": {
      "const": "john-lomein.persona-qualification-native-bundle-manifest.v3"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?@[0-9a-f]{64}$"
    },
    "role": {
      "enum": [
        "capture",
        "coordinator",
        "public-verifier",
        "verifier"
      ]
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "filesystem_policy": {
      "const": {
        "acl": "forbidden",
        "bytecode": "forbidden-pyc-and-pyo",
        "cache_directories": "forbidden-__pycache__",
        "extended_attributes": "forbidden-except-macos-platform-security-labels",
        "hardlinks": "forbidden",
        "inspection": "descriptor-relative-no-follow",
        "inventory": "complete-root-relative-files-and-directories",
        "path_encoding": "utf-8-nfc-casefold-unique",
        "platform_xattr_allowlist": [
          "com.apple.provenance",
          "com.apple.rootless"
        ],
        "special_files": "forbidden",
        "symlinks": "forbidden",
        "unexpected_entries": "forbidden"
      }
    },
    "ownership_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/ownershipClass"
      }
    },
    "mode_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/modeClass"
      }
    },
    "python_runtime": {
      "$ref": "#/$defs/pythonRuntime"
    },
    "wheel_provenance": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/wheel"
      }
    },
    "macho": {
      "$ref": "#/$defs/macho"
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "activation": {
      "const": {
        "activation_receipt_schema": null,
        "activation_receipts_available": false,
        "native_closure_status": "unproven-for-live-installation",
        "privileged_canaries": "unproven",
        "production_activation": false
      }
    },
    "digests": {
      "$ref": "#/$defs/digests"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?$)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)__pycache__(?:/|$))(?!.*\\.(?:pyc|pyo)$).+$"
    },
    "directoryPath": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "$ref": "#/$defs/relativePath"
        }
      ]
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*//)(?!.*(?:^|/)\\.\\.?$)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "architecture",
        "binary_format",
        "minimum_macos"
      ],
      "properties": {
        "system": {
          "const": "darwin"
        },
        "architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "binary_format": {
          "const": "mach-o-64-little-endian"
        },
        "minimum_macos": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "ownershipClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uid",
        "gid"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "modeClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object_type",
        "mode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "object_type": {
          "enum": [
            "directory",
            "file"
          ]
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        }
      }
    },
    "pythonRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "abi_tag",
        "executable_path",
        "stdlib_paths",
        "vendor_paths",
        "sys_path",
        "entrypoint",
        "invocation",
        "environment"
      ],
      "properties": {
        "implementation": {
          "const": "cpython"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "abi_tag": {
          "type": "string",
          "pattern": "^cp[0-9]{2,3}$"
        },
        "executable_path": {
          "$ref": "#/$defs/relativePath"
        },
        "stdlib_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "vendor_paths": {
          "type": "array",
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "sys_path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/directoryPath"
          }
        },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "path",
            "sha256",
            "execution"
          ],
          "properties": {
            "role": {
              "enum": [
                "capture",
                "coordinator",
                "public-verifier",
                "verifier"
              ]
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "execution": {
              "const": "runpy.run_path"
            }
          }
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "flags",
            "isolated",
            "site_import",
            "bytecode_write"
          ],
          "properties": {
            "executable": {
              "const": "bundle-relative"
            },
            "flags": {
              "const": [
                "-I",
                "-S",
                "-B"
              ]
            },
            "isolated": {
              "const": true
            },
            "site_import": {
              "const": false
            },
            "bytecode_write": {
              "const": false
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clear",
            "allowlist",
            "values"
          ],
          "properties": {
            "clear": {
              "const": true
            },
            "allowlist": {
              "const": [
                "HOME",
                "LANG",
                "LC_ALL",
                "PATH",
                "TMPDIR",
                "TZ"
              ]
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "HOME",
                "LANG",
                "LC_ALL",
                "PATH",
                "TMPDIR",
                "TZ"
              ],
              "properties": {
                "HOME": {
                  "$ref": "#/$defs/absolutePath"
                },
                "LANG": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "LC_ALL": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "PATH": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "TMPDIR": {
                  "$ref": "#/$defs/absolutePath"
                },
                "TZ": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        }
      }
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "wheel_filename",
        "wheel_sha256",
        "source_url",
        "wheel_tags",
        "installer",
        "record_path",
        "record_sha256",
        "installed_paths",
        "installed_paths_sha256"
      ],
      "properties": {
        "distribution": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]{0,126}$"
        },
        "wheel_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.+-]{1,240}\\.whl$"
        },
        "wheel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^#]+$",
          "maxLength": 2048
        },
        "wheel_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]+-[A-Za-z0-9_.]+-[A-Za-z0-9_.]+$"
          }
        },
        "installer": {
          "enum": [
            "manual-wheel-extract",
            "pip",
            "uv"
          ]
        },
        "record_path": {
          "$ref": "#/$defs/relativePath"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "installed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "installed_paths_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "macho": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "objects",
        "dependencies",
        "system_dependency_allowlist",
        "graph_status"
      ],
      "properties": {
        "format": {
          "const": "mach-o-64-little-endian"
        },
        "objects": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/machoObject"
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/machoDependency"
          }
        },
        "system_dependency_allowlist": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        },
        "graph_status": {
          "const": "parsed-and-resolved-against-complete-inventory"
        }
      }
    },
    "machoObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "architecture",
        "cpu_subtype",
        "file_type",
        "flags",
        "uuid",
        "minimum_macos",
        "sdk",
        "install_name",
        "install_name_current_version",
        "install_name_compatibility_version",
        "rpaths",
        "load_commands_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "cpu_subtype": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "file_type": {
          "enum": [
            "execute",
            "dylib",
            "bundle"
          ]
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "uuid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          ]
        },
        "minimum_macos": {
          "$ref": "#/$defs/version"
        },
        "sdk": {
          "$ref": "#/$defs/version"
        },
        "install_name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          ]
        },
        "install_name_current_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/version"
            }
          ]
        },
        "install_name_compatibility_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/version"
            }
          ]
        },
        "rpaths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^@(executable_path|loader_path|rpath)(?:/.*)?$"
          }
        },
        "load_commands_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "machoDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_architecture",
        "load_command",
        "install_name",
        "current_version",
        "compatibility_version",
        "target_class",
        "target_path",
        "target_sha256"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "load_command": {
          "enum": [
            "LC_LOAD_DYLIB",
            "LC_LOAD_WEAK_DYLIB",
            "LC_LAZY_LOAD_DYLIB",
            "LC_REEXPORT_DYLIB",
            "LC_LOAD_UPWARD_DYLIB"
          ]
        },
        "install_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "current_version": {
          "$ref": "#/$defs/version"
        },
        "compatibility_version": {
          "$ref": "#/$defs/version"
        },
        "target_class": {
          "enum": [
            "bundle",
            "macos-system"
          ]
        },
        "target_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "target_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    },
    "directoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "uid",
        "gid",
        "ownership_class",
        "mode_class"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/directoryPath"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ownership_class": {
          "$ref": "#/$defs/token"
        },
        "mode_class": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "uid",
        "gid",
        "ownership_class",
        "mode_class",
        "size",
        "sha256",
        "content_type"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ownership_class": {
          "$ref": "#/$defs/token"
        },
        "mode_class": {
          "$ref": "#/$defs/token"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_type": {
          "enum": [
            "data",
            "mach-o"
          ]
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directories",
        "files",
        "directory_count",
        "file_count",
        "total_bytes"
      ],
      "properties": {
        "directories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/directoryRecord"
          }
        },
        "files": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/fileRecord"
          }
        },
        "directory_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_content_sha256",
        "filesystem_policy_sha256",
        "inventory_sha256",
        "ownership_policy_sha256",
        "python_runtime_sha256",
        "wheel_provenance_sha256",
        "macho_graph_sha256"
      ],
      "properties": {
        "bundle_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "filesystem_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ownership_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "python_runtime_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "wheel_provenance_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "macho_graph_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
