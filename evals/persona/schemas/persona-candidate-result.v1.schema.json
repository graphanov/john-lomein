{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:john-lomein:schema:persona-candidate-result:v1",
  "title": "John Lomein persona candidate result v1",
  "description": "The single JSON object a candidate adapter must write to stdout. The runner additionally checks all identities and digests against the request and rejects session reuse.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "scenario_id",
    "session_id",
    "adapter",
    "response",
    "binding",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "john-lomein.persona-candidate-result.v1"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "candidate_id": {
      "$ref": "#/$defs/component"
    },
    "scenario_id": {
      "$ref": "#/$defs/component"
    },
    "session_id": {
      "$ref": "#/$defs/token"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_sha256",
        "soul_sha256",
        "effective_prompt_sha256",
        "requested_model",
        "effective_model",
        "provider_returned_model"
      ],
      "properties": {
        "request_sha256": {
          "$ref": "#/$defs/digest"
        },
        "soul_sha256": {
          "$ref": "#/$defs/digest"
        },
        "effective_prompt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "requested_model": {
          "$ref": "#/$defs/model"
        },
        "effective_model": {
          "$ref": "#/$defs/model"
        },
        "provider_returned_model": {
          "$ref": "#/$defs/model"
        }
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
    },
    "component": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "response": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40000,
      "pattern": "\\S",
      "not": {
        "pattern": "\\u0000"
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "route_id": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning_effort"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/token"
        },
        "model": {
          "$ref": "#/$defs/token"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_home",
        "fresh_hermes_home",
        "empty_cwd",
        "fresh_session",
        "tools",
        "memory_loaded",
        "skills_loaded",
        "plugins_loaded",
        "mcp_servers",
        "prior_session_loaded",
        "production_credentials_present",
        "hermes_kanban_task_present"
      ],
      "properties": {
        "fresh_home": {
          "const": true
        },
        "fresh_hermes_home": {
          "const": true
        },
        "empty_cwd": {
          "const": true
        },
        "fresh_session": {
          "const": true
        },
        "tools": {
          "type": "array",
          "maxItems": 0
        },
        "memory_loaded": {
          "const": false
        },
        "skills_loaded": {
          "const": false
        },
        "plugins_loaded": {
          "const": false
        },
        "mcp_servers": {
          "type": "array",
          "maxItems": 0
        },
        "prior_session_loaded": {
          "const": false
        },
        "production_credentials_present": {
          "const": false
        },
        "hermes_kanban_task_present": {
          "const": false
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_reason",
        "retries",
        "fallback_used",
        "usage",
        "isolation"
      ],
      "properties": {
        "finish_reason": {
          "enum": [
            "stop",
            "end_turn",
            "completed"
          ]
        },
        "retries": {
          "const": 0
        },
        "fallback_used": {
          "const": false
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "isolation": {
          "$ref": "#/$defs/isolation"
        }
      }
    }
  }
}
