{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:john-lomein:schema:persona-judge-result:v1",
  "title": "John Lomein persona judge result v1",
  "description": "The single JSON object the independent judge adapter must write to stdout. The runner additionally checks request/response/criteria digests, route and model equality, exact criterion order and completeness, and session uniqueness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "scenario_id",
    "request_sha256",
    "response_sha256",
    "criteria_sha256",
    "session_id",
    "judge",
    "binding",
    "judgments",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "john-lomein.persona-judge-result.v1"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "candidate_id": {
      "$ref": "#/$defs/component"
    },
    "scenario_id": {
      "$ref": "#/$defs/component"
    },
    "request_sha256": {
      "$ref": "#/$defs/digest"
    },
    "response_sha256": {
      "$ref": "#/$defs/digest"
    },
    "criteria_sha256": {
      "$ref": "#/$defs/digest"
    },
    "session_id": {
      "$ref": "#/$defs/token"
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route_id",
        "provider",
        "model",
        "reasoning_effort",
        "independent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "route_id": {
          "$ref": "#/$defs/token"
        },
        "provider": {
          "$ref": "#/$defs/token"
        },
        "model": {
          "$ref": "#/$defs/token"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/token"
        },
        "independent": {
          "const": true
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_model",
        "effective_model",
        "provider_returned_model"
      ],
      "properties": {
        "requested_model": {
          "$ref": "#/$defs/model"
        },
        "effective_model": {
          "$ref": "#/$defs/model"
        },
        "provider_returned_model": {
          "$ref": "#/$defs/model"
        }
      }
    },
    "judgments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "verdict",
          "rationale"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^(?:expected|forbidden)-[0-9]{2,}$"
          },
          "verdict": {
            "type": "boolean"
          },
          "rationale": {
            "$ref": "#/$defs/rationale"
          }
        }
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
    },
    "component": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S",
      "not": {
        "pattern": "\\u0000"
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning_effort"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/token"
        },
        "model": {
          "$ref": "#/$defs/token"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_home",
        "fresh_hermes_home",
        "empty_cwd",
        "fresh_session",
        "tools",
        "memory_loaded",
        "skills_loaded",
        "plugins_loaded",
        "mcp_servers",
        "prior_session_loaded",
        "production_credentials_present",
        "hermes_kanban_task_present"
      ],
      "properties": {
        "fresh_home": {
          "const": true
        },
        "fresh_hermes_home": {
          "const": true
        },
        "empty_cwd": {
          "const": true
        },
        "fresh_session": {
          "const": true
        },
        "tools": {
          "type": "array",
          "maxItems": 0
        },
        "memory_loaded": {
          "const": false
        },
        "skills_loaded": {
          "const": false
        },
        "plugins_loaded": {
          "const": false
        },
        "mcp_servers": {
          "type": "array",
          "maxItems": 0
        },
        "prior_session_loaded": {
          "const": false
        },
        "production_credentials_present": {
          "const": false
        },
        "hermes_kanban_task_present": {
          "const": false
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_reason",
        "retries",
        "fallback_used",
        "usage",
        "isolation"
      ],
      "properties": {
        "finish_reason": {
          "enum": [
            "stop",
            "end_turn",
            "completed"
          ]
        },
        "retries": {
          "const": 0
        },
        "fallback_used": {
          "const": false
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "isolation": {
          "$ref": "#/$defs/isolation"
        }
      }
    }
  }
}
